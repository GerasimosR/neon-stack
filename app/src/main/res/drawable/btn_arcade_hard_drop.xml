<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/btn_hard_drop_pressed" />
            <stroke android:width="2dp" android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/btn_hard_drop" />
            <stroke android:width="2dp" android:color="@color/accent_pink" />
        </shape>
    </item>
</selector>
